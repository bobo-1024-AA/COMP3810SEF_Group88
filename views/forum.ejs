<h1>Forum</h1><p>Find teammates and share your experiences of FAITH activities.</p>
<% if(user.role==='student'){ %><form class="card stack forum-compose" method="post" action="/forum"><h2>Create a post</h2><label>Title<input name="title" maxlength="120" required></label><label>Event (optional)<select name="event"><option value="">General discussion or team recruitment</option><% events.forEach(event=>{ %><option value="<%= event._id %>"><%= event.name %> · <%= new Date(event.date).toLocaleDateString('en-GB',{timeZone:'Asia/Hong_Kong'}) %></option><% }) %></select></label><label>Post<textarea name="body" maxlength="4000" required></textarea></label><button>Publish post</button></form><% } %>
<div class="forum-posts"><% if(!posts.length){ %><p>No posts yet.</p><% } %><% posts.forEach(post=>{ %><article class="card forum-post" id="post-<%= post._id %>"><h2><%= post.title %></h2><p class="forum-meta"><%= post.author?.name || 'Former user' %> · <%= new Date(post.createdAt).toLocaleString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> HKT<% if(post.event){ %> · <%= post.event.name %><%= post.event.removed ? ' (removed)' : '' %><% } %></p><p class="forum-body"><%= post.body %></p><% if(user.role==='sao'){ %><form method="post" action="/forum/<%= post._id %>/delete" onsubmit="return confirm('Delete this post and its replies?')"><button class="secondary">Delete post</button></form><% } %><h3>Replies</h3><% post.replies.forEach(reply=>{ %><div class="forum-reply"><strong><%= reply.author?.name || 'Former user' %></strong><p class="forum-body"><%= reply.body %></p></div><% }) %><% if(!post.replies.length){ %><p>No replies yet.</p><% } %><% if(user.role==='student'){ %><form class="stack" method="post" action="/forum/<%= post._id %>/replies"><label>Reply<textarea name="body" maxlength="1000" required></textarea></label><button>Reply</button></form><% } %></article><% }) %></div>
