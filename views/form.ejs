<div class="narrow"><p class="eyebrow">SAO · EVENTS</p><h1><%= event?'Edit event':'Create event' %></h1><form method="post" action="<%= event?'/admin/events/'+event._id:'/admin/events' %>" class="card stack"><label>Name<input name="name" value="<%= event?.name || '' %>" required></label><label>Description<textarea name="description" required><%= event?.description || '' %></textarea></label><label>Category<select name="category" required><% categories.forEach(c=>{ %><option <%= event?.category===c?'selected':'' %>><%= c %></option><% }) %></select></label><label>Location<input name="location" value="<%= event?.location || '' %>" required></label><label>Event date and time (Hong Kong)<input type="datetime-local" name="date" value="<%= event ? new Date(new Date(event.date).getTime()+8*3600000).toISOString().slice(0,16) : '' %>" required></label><label>Registration deadline (Hong Kong)<input type="datetime-local" name="deadline" value="<%= event ? new Date(new Date(event.deadline).getTime()+8*3600000).toISOString().slice(0,16) : '' %>" required></label><label>Capacity<input type="number" name="capacity" min="1" value="<%= event?.capacity || 1 %>" required></label><label>Activity hours<input type="number" name="hours" min="0.1" step="0.1" value="<%= event?.hours || 1 %>" required></label><button>Save event</button><a href="/admin">Cancel</a></form></div><script>document.querySelector('form').addEventListener('submit',function(){for(const n of ['date','deadline']){const el=this.elements[n]; if(el.value) {const hidden=document.createElement('input');hidden.type='hidden';hidden.name=n;hidden.value=el.value+':00+08:00';el.disabled=true;this.appendChild(hidden)}}});</script>
