<div class="heading"><div><p class="eyebrow">SAO</p><h1>Student activity records</h1><p>View and update registrations, including cancelled records and removed activities.</p></div><a href="/admin">← SAO dashboard</a></div>
<% if(updated){ %><p class="success" role="status">Activity record updated.</p><% } %>
<form class="filters" method="get" action="/admin/records"><label>Search by student name, email or activity<input type="search" name="search" value="<%= search %>"></label><label>Status<select name="status"><option value="">All statuses</option><% ['pending','confirmed','waitlisted','completed','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s[0].toUpperCase()+s.slice(1) %></option><% }) %></select></label><button>Search</button><a href="/admin/records">Clear</a></form>
<p><%= records.length %> record<%= records.length===1?'':'s' %></p>
<div class="card"><% if(!records.length){ %><p>No matching activity records.</p><% } %><% records.forEach(r=>{ %><div class="row record-row"><div><strong><%= r.student.name %></strong><p><%= r.student.email %></p><p><strong><%= r.event?.name || 'Activity unavailable' %></strong><% if(r.event){ %> · <%= r.event.category %> · <%= new Date(r.event.date).toLocaleString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> HKT<%= r.event.removed?' · Event removed':'' %><% } %></p><% if(r.event){ %><p><a href="/admin/events/<%= r.event._id %>/records">Manage activity records</a></p><% } %><p>Registered: <%= new Date(r.createdAt).toLocaleDateString('en-GB',{timeZone:'Asia/Hong_Kong'}) %></p></div><% if(r.event){ %><form class="record-edit" method="post" action="/admin/records/<%= r._id %>"><label>Status for <%= r.student.name %>, <%= r.event.name %><select name="status"><% ['pending','confirmed','waitlisted','completed','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= r.status===s?'selected':'' %>><%= s[0].toUpperCase()+s.slice(1) %></option><% }) %></select></label><button>Save</button></form><% } else { %><span class="status"><%= r.status %></span><% } %></div><% }) %></div>
