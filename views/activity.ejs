<p class="eyebrow">YOUR JOURNEY</p><h1>My activity & progress</h1><p>Completed activities count towards each category's goal of 5 hours and 5 different activities.</p><div class="progress-grid"><% progress.forEach(p=>{ %><div class="card"><h3><%= p.category %></h3><p><strong><%= p.hours %> / 5</strong> hours</p><progress max="5" value="<%= p.hours %>"></progress><p><strong><%= p.count %> / 5</strong> activities</p><progress max="5" value="<%= p.count %>"></progress></div><% }) %></div><h2>Registration history</h2><div class="card"><% if(!regs.length){ %><p>You have no registrations yet.</p><% } %><% regs.forEach(r=>{ if(!r.event)return; %><div class="row"><div><strong><%= r.event.name %></strong><p><%= r.event.category %> · <%= new Date(r.event.date).toLocaleDateString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> <%= r.event.removed?'· Event removed':'' %></p></div><span class="status"><%= r.status %></span><% if(!r.event.removed&&['pending','confirmed','waitlisted'].includes(r.status)&&new Date(r.event.date)>new Date()){ %><form method="post" action="/registrations/<%= r._id %>/cancel"><button class="secondary">Cancel</button></form><% } %></div><% }) %></div>
