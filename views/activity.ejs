<% const schemeLevel=progress.length && progress.every(p=>p.hours>=5) ? "Mastering Level" : progress.length && progress.every(p=>p.hours>=3) ? "Accomplishing Level" : "Beginning Level"; %><section class="scheme-level"><h1>Scheme Level</h1><p><strong><%= schemeLevel %></strong></p></section><div class="progress-grid"><% progress.forEach(p=>{ %><div class="card"><h3><%= p.category %></h3><p><strong><%= p.hours %> / 5</strong> hours</p><progress max="5" value="<%= p.hours %>"></progress><p><strong><%= p.count %> / 5</strong> activities</p><progress max="5" value="<%= p.count %>"></progress></div><% }) %></div><section class="category-records" aria-label="Activities by category">
<% const categoryLabels={'Future Skills & Intelligence':'智 Future Skills & Intelligence (F)','Aesthetics & Spirituality':'美 Aesthetics & Spirituality (A)','Igniting & Sports':'健 Igniting & Sports (I)','Temperance & Justice':'御 Temperance & Justice (T)','Humanity & Love':'仁 Humanity & Love (H)'}; %>
<% progress.forEach(p=>{ const completed=regs.filter(r=>r.status==='completed' && r.event && r.event.category===p.category); %>
<section class="category-record">
<h3><%= categoryLabels[p.category] || p.category %>: <%= p.hours %> hours</h3>
<div class="category-table-wrap"><table><thead><tr><th scope="col">Academic Year</th><th scope="col">Activities</th><th scope="col">Hours</th></tr></thead><tbody>
<% if(!completed.length){ %><tr><td colspan="3">No completed activities yet.</td></tr><% } %>
<% completed.forEach(r=>{ const parts=new Intl.DateTimeFormat('en-US',{timeZone:'Asia/Hong_Kong',year:'numeric',month:'numeric'}).formatToParts(new Date(r.event.date)); const year=Number(parts.find(part=>part.type==='year').value); const month=Number(parts.find(part=>part.type==='month').value); const startYear=month>=9?year:year-1; %>
<tr><td><%= startYear %>/<%= startYear+1 %></td><td><%= r.event.name %><%= r.event.removed ? ' (removed)' : '' %></td><td><%= r.event.hours %></td></tr>
<% }) %></tbody></table></div></section><% }) %></section>
<h2>Registration history</h2><div class="card"><% if(!regs.length){ %><p>You have no registrations yet.</p><% } %><% regs.forEach(r=>{ if(!r.event)return; %><div class="row"><div><strong><%= r.event.name %></strong><p><%= r.event.category %> · <%= new Date(r.event.date).toLocaleDateString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> <%= r.event.removed?'· Event removed':'' %></p></div><span class="status student-status status-<%= r.status %>"><%= r.status %></span><% if(!r.event.removed&&['pending','confirmed','waitlisted'].includes(r.status)&&new Date(r.event.date)>new Date()){ %><form method="post" action="/registrations/<%= r._id %>/cancel"><button class="secondary">Cancel</button></form><% } %></div><% }) %></div>
