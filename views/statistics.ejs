<section class="statistics-section"><h2>Students by level</h2><div class="progress-grid"><div class="card"><h3>Total students</h3><p><strong><%= Object.values(levels).reduce((total,count)=>total+count,0) %></strong> students</p></div><% Object.entries(levels).forEach(([level,count])=>{ %><div class="card"><h3><%= level %></h3><p><strong><%= count %></strong> students</p></div><% }) %></div></section>
<section class="statistics-section"><h2>Top 5 students by category</h2><% categoryRankings.forEach(({category,students})=>{ %><div class="category-record"><h3><%= category %></h3><div class="category-table-wrap"><table><thead><tr><th scope="col">Rank</th><th scope="col">Student</th><th scope="col">Email</th><th scope="col">Level</th><th scope="col">Hours</th></tr></thead><tbody><% students.forEach((item,index)=>{ %><tr><td><%= index+1 %></td><td><%= item.student.name %></td><td><%= item.student.email %></td><td><%= item.level %></td><td><%= Number(item.hours[category].toFixed(2)) %></td></tr><% }) %></tbody></table></div><% if(!students.length){ %><p>No completed activity hours yet.</p><% } %></div><% }) %></section>
<section class="statistics-section"><h2>Top 20 students by total hours — Mastering Level</h2><div class="category-record"><div class="category-table-wrap"><table><thead><tr><th scope="col">Rank</th><th scope="col">Student</th><th scope="col">Email</th><th scope="col">Total hours</th></tr></thead><tbody><% mastering.forEach((item,index)=>{ %><tr><td><%= index+1 %></td><td><%= item.student.name %></td><td><%= item.student.email %></td><td><%= Number(item.total.toFixed(2)) %></td></tr><% }) %></tbody></table></div><% if(!mastering.length){ %><p>No students have reached Mastering Level yet.</p><% } %></div></section>
