<div class="heading"><div><p class="eyebrow">EXPLORE & PARTICIPATE</p><h1>Find your next activity</h1><p>Explore opportunities across the five FAITH categories.</p></div></div>
<form class="filters" method="get"><input name="search" placeholder="Search by name" value="<%= query.search || '' %>"><select name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option <%= query.category===c?'selected':'' %>><%= c %></option><% }) %></select><button>Search</button></form>
<div class="grid"><% events.forEach(e=>{ const r=regs.find(r=>String(r.event)===String(e._id)&&r.status!=='cancelled'); const date=new Date(e.date); %>
<article class="card event"><% if(e.hasImage){ %><img class="event-image" src="/events/<%= e._id %>/image" alt="" loading="lazy"><% } else { %><div class="event-image event-placeholder" aria-hidden="true">METRO FAITH</div><% } %>
<div class="event-content"><span class="tag"><%= e.category %></span><h2><%= e.name %></h2><p><%= e.description %></p>
<p class="details"><strong>Date:</strong> <%= date.toLocaleDateString('en-GB',{timeZone:'Asia/Hong_Kong'}) %><br><strong>Times:</strong> <%= date.toLocaleTimeString('en-GB',{timeZone:'Asia/Hong_Kong',hour:'2-digit',minute:'2-digit',hour12:false}) %> HKT<br><strong>Venue:</strong> <%= e.location %><br><strong>Engagement Hours:</strong> <%= e.hours %><br><strong>Capacity:</strong> <%= e.capacity %><br><strong>Registration ddl:</strong> <%= new Date(e.deadline).toLocaleString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> HKT</p>
<% if(user.role==='student'){ %><div class="event-action"><% if(r){ %><span class="status event-status"><%= r.status %></span><% } else if(new Date(e.deadline)>new Date()&&date>new Date()){ %><form method="post" action="/events/<%= e._id %>/register"><button class="event-register">Register</button></form><% } else { %><span class="status event-status">Registration closed</span><% } %></div><% } %>
</div></article><% }) %></div><% if(!events.length){ %><p>No events found.</p><% } %>
