<div class="heading"><div><p class="eyebrow">EXPLORE & PARTICIPATE</p><h1>Find your next activity</h1><p>Explore opportunities across the five FAITH categories.</p></div></div><form class="filters" method="get"><input name="search" placeholder="Search by name" value="<%= query.search || '' %>"><select name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option <%= query.category===c?'selected':'' %>><%= c %></option><% }) %></select><button>Search</button></form><div class="grid"><% events.forEach(e=>{ const r=regs.find(r=>String(r.event)===String(e._id)&&r.status!=='cancelled'); %><article class="card event"><span class="tag"><%= e.category %></span><h2><%= e.name %></h2><p><%= e.description %></p><p class="details"><strong>When</strong> <%= new Date(e.date).toLocaleString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> HKT<br><strong>Where</strong> <%= e.location %><br><strong>Hours</strong> <%= e.hours %> · <strong>Capacity</strong> <%= e.capacity %><br><strong>Deadline</strong> <%= new Date(e.deadline).toLocaleString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> HKT</p><% if(user.role==='student'){ if(r){ %><span class="status"><%= r.status %></span><% } else if(new Date(e.deadline)>new Date()&&new Date(e.date)>new Date()){ %><form method="post" action="/events/<%= e._id %>/register"><button>Register</button></form><% } else { %><span class="status">Registration closed</span><% }} %></article><% }) %></div><% if(!events.length){ %><p>No events found.</p><% } %>
