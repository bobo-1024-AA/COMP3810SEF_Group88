<div class="heading"><div class="admin-actions"><a class="button secondary" href="/admin/records">Student activity records</a> <a class="button" href="/admin/events/new">+ Create event</a></div></div>
<h2>Events</h2>
<% categories.forEach(category=>{ const grouped=events.filter(e=>e.category===category); %>
<section class="admin-category"><h3><%= category %></h3><div class="card">
<% if(!grouped.length){ %><p>No events in this category.</p><% } %>
<% grouped.forEach(e=>{ %><div class="row"><div><strong><%= e.name %></strong><p><%= new Date(e.date).toLocaleString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> HKT</p></div><a href="/admin/events/<%= e._id %>/records">Student records</a><a href="/admin/events/<%= e._id %>/edit">Edit</a><form method="post" action="/admin/events/<%= e._id %>/delete" onsubmit="return confirm('Remove this event?')"><button class="secondary">Remove</button></form></div><% }) %>
</div></section><% }) %>
