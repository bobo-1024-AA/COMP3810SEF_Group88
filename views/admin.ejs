<div class="heading"><div class="admin-actions"><a class="button secondary dashboard-action" href="/admin/records">Student activity records</a> <a class="button" href="/admin/events/new">+ Create event</a></div></div>
<form class="filters" method="get" action="/admin"><input type="search" name="search" aria-label="Search events by name" placeholder="Search events by name" value="<%= search %>"><button type="submit">Search</button><a class="button secondary dashboard-action" href="/admin">Clear</a></form>
<% categories.forEach(category=>{ const grouped=events.filter(e=>e.category===category); %>
<section class="admin-category"><h3><%= category %></h3><div class="card">
<% if(!grouped.length){ %><p>No events in this category.</p><% } %>
<% grouped.forEach(e=>{ %><div class="row"><div><strong><%= e.name %></strong><p><%= new Date(e.date).toLocaleString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> HKT</p></div><a class="button secondary dashboard-action" href="/admin/events/<%= e._id %>/records">Student records</a><a class="button secondary dashboard-action" href="/admin/events/<%= e._id %>/edit">Edit</a><form method="post" action="/admin/events/<%= e._id %>/delete" onsubmit="return confirm('Delete this event?')"><button class="secondary dashboard-remove">Delete</button></form></div><% }) %>
</div></section><% }) %>
