<div class="heading"><div><p class="eyebrow">SAO</p><h1>Manage activities</h1><p>Create events and manage student registrations.</p></div><a class="button" href="/admin/events/new">+ Create event</a></div><h2>Events</h2><div class="card"><% if(!events.length){ %><p>No events yet.</p><% } %><% events.forEach(e=>{ %><div class="row"><div><strong><%= e.name %></strong><p><%= e.category %> · <%= new Date(e.date).toLocaleString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> HKT</p></div><a href="/admin/events/<%= e._id %>/edit">Edit</a><form method="post" action="/admin/events/<%= e._id %>/delete" onsubmit="return confirm('Remove this event?')"><button class="secondary">Remove</button></form></div><% }) %></div><h2>Registrations</h2><div class="card"><% const active=regs.filter(r=>r.event && !r.event.removed && r.student); if(!active.length){ %><p>No registrations yet.</p><% } %><% active.forEach(r=>{ %><div class="row"><div><strong><%= r.student.name %></strong><p><%= r.student.email %> · <%= r.event.name %></p></div><span class="status"><%= r.status %></span><% if(r.status==='pending'||(r.status==='confirmed'&&new Date(r.event.date)<=new Date())){ %><form method="post" action="/admin/registrations/<%= r._id %>"><button name="status" value="<%= r.status==='pending'?'confirmed':'completed' %>"><%= r.status==='pending'?'Confirm':'Mark completed' %></button></form><% } %></div><% }) %></div>
