<div class="heading"><div><p class="eyebrow">SAO · ACTIVITY RECORDS</p><h1><%= event.name %></h1><p><%= event.category %> · <%= new Date(event.date).toLocaleString('en-GB',{timeZone:'Asia/Hong_Kong'}) %> HKT<%= event.removed?' · Event removed':'' %></p></div><a href="/admin">← SAO dashboard</a></div>
<% if(updated){ %><p class="success" role="status">Activity records updated.</p><% } %>
<% if(added || skipped){ %><p class="success" role="status"><%= added %> record(s) added or restored. <%= skipped %> already had a record and were skipped.</p><% } %>
<div class="card"><h2>Add student records</h2><p>Search by name or email and select one or more students. Your selections stay checked when you change the search.</p>
<form method="post" action="/admin/events/<%= event._id %>/records" class="student-add-form">
<label for="student-search">Search students<input id="student-search" type="search" autocomplete="off" placeholder="Enter a name or email"></label>
<div class="student-picker-tools"><button type="button" class="secondary" id="select-visible">Select all shown</button><button type="button" class="secondary" id="clear-selected">Clear selection</button><span id="student-selection-count" role="status" aria-live="polite">0 selected</span></div>
<fieldset class="student-picker"><legend>Select students</legend><% const existingByStudent = new Map(records.filter(r=>r.student).map(r=>[String(r.student._id),r.status])); %><% if(!students.length){ %><p>No student accounts found.</p><% } %><% students.forEach(s=>{ const existingStatus=existingByStudent.get(String(s._id)); %><label class="student-option" data-search="<%= (s.name+' '+s.email).toLowerCase() %>"><input type="checkbox" name="students" value="<%= s._id %>"><span><strong><%= s.name %></strong><br><%= s.email %><% if(existingStatus){ %> · <%= existingStatus==='cancelled'?'Cancelled — can be restored':'Already has a record ('+existingStatus+')' %><% } %></span></label><% }) %><p id="student-no-results" hidden>No students match your search.</p></fieldset>
<div class="student-add-controls"><label>Status<select name="status" required><% ['pending','confirmed','waitlisted','completed','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= s===(new Date(event.date)<=new Date()?'completed':'pending')?'selected':'' %>><%= s[0].toUpperCase()+s.slice(1) %></option><% }) %></select></label><button type="submit">Add selected students</button></div></form>
<p>For an activity that has started, choose Completed to count engagement hours. Completed records can be added even when capacity is full. Cancelled records can be restored; other existing records are skipped.</p></div>
<h2>Student records (<%= records.length %>)</h2><div class="card"><% if(!records.length){ %><p>No student records for this activity yet.</p><% } %><% records.forEach(r=>{ %><div class="row record-row"><div><strong><%= r.student?.name || 'Student unavailable' %></strong><p><%= r.student?.email || '' %> · Registered <%= new Date(r.createdAt).toLocaleDateString('en-GB',{timeZone:'Asia/Hong_Kong'}) %></p></div><div class="record-actions"><form class="record-edit" method="post" action="/admin/records/<%= r._id %>"><input type="hidden" name="returnToEvent" value="1"><label>Status for <%= r.student?.name || 'student' %><select name="status"><% ['pending','confirmed','waitlisted','completed','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= r.status===s?'selected':'' %>><%= s[0].toUpperCase()+s.slice(1) %></option><% }) %></select></label><button>Save</button></form><form method="post" action="/admin/events/<%= event._id %>/records/<%= r._id %>/delete" onsubmit="return confirm('Delete this student record? Completed hours will be removed from the student’s progress.')"><button type="submit" class="secondary">Delete</button></form></div></div><% }) %></div>
<script>
(()=>{const search=document.getElementById('student-search'),options=[...document.querySelectorAll('.student-option')],count=document.getElementById('student-selection-count'),empty=document.getElementById('student-no-results');function updateCount(){count.textContent=options.filter(option=>option.querySelector('input').checked).length+' selected'}function filter(){const term=search.value.trim().toLocaleLowerCase();let visible=0;for(const option of options){option.hidden=!option.dataset.search.includes(term);if(!option.hidden)visible++}empty.hidden=visible>0}search.addEventListener('input',filter);for(const option of options)option.querySelector('input').addEventListener('change',updateCount);document.getElementById('select-visible').addEventListener('click',()=>{for(const option of options)if(!option.hidden)option.querySelector('input').checked=true;updateCount()});document.getElementById('clear-selected').addEventListener('click',()=>{for(const option of options)option.querySelector('input').checked=false;updateCount()})})();
</script>
